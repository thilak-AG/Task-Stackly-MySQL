 // CREATE TABLES
 static void createTables(Connection con) {
 try {
 Statement st = con.createStatement();
 st.executeUpdate(
 "CREATE TABLE IF NOT EXISTS employees (" +
 "emp_id INT PRIMARY KEY AUTO_INCREMENT," +
 "emp_name VARCHAR(50)," +
 "department VARCHAR(50)," +
 "email VARCHAR(100))"
 );
 st.executeUpdate(
 "CREATE TABLE IF NOT EXISTS leave_requests (" +
 "leave_id INT PRIMARY KEY AUTO_INCREMENT," +
 "emp_id INT," +
 "leave_type VARCHAR(30)," +
 "start_date DATE," +
 "end_date DATE," +
 "reason VARCHAR(100)," +
 "status VARCHAR(20) DEFAULT 'Pending'," +
 "FOREIGN KEY(emp_id) REFERENCES employees(emp_id))"
 );
 st.executeUpdate(
 "CREATE TABLE IF NOT EXISTS leave_balance (" +
 "emp_id INT PRIMARY KEY," +
 "total_leaves INT DEFAULT 20," +
 "used_leaves INT DEFAULT 0," +
 "remaining_leaves INT DEFAULT 20," +
 "FOREIGN KEY(emp_id) REFERENCES employees(emp_id))"
 );
 System.out.println("Tables created successfully!");
 } catch (SQLException e) {
 e.printStackTrace();
 }
 }
 // 1. EMPLOYEE REGISTRATION - CREATE
 static void addEmployee(Connection con) {
 try {
 System.out.print("Enter employee name: ");
 String name = sc.nextLine();
 System.out.print("Enter department: ");
 String dept = sc.nextLine();
 System.out.print("Enter email: ");
 String email = sc.nextLine();
 String sql =
 "INSERT INTO employees(emp_name, department, email) " +
 "VALUES(?,?,?)";
 PreparedStatement ps =
 con.prepareStatement(
 sql, Statement.RETURN_GENERATED_KEYS);
 ps.setString(1, name);
 ps.setString(2, dept);
 ps.setString(3, email);
 ps.executeUpdate();
 ResultSet rs = ps.getGeneratedKeys();
 if (rs.next()) {
 int id = rs.getInt(1);
 PreparedStatement balance =
 con.prepareStatement(
 "INSERT INTO leave_balance(emp_id) VALUES(?)");
 balance.setInt(1, id);
 balance.executeUpdate();
 System.out.println(
 "Employee registered successfully!");
 System.out.println("Employee ID: " + id);
 }
 } catch (SQLException e) {
 e.printStackTrace();
 }
 }
