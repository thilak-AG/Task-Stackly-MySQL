 // 5. APPLY LEAVE
 static void applyLeave(Connection con) {
 try {
 System.out.print("Enter employee ID: ");
 int empId = Integer.parseInt(sc.nextLine());
 System.out.print("Enter leave type: ");
 String type = sc.nextLine();
 System.out.print("Enter start date (YYYY-MM-DD): ");
 String start = sc.nextLine();
 System.out.print("Enter end date (YYYY-MM-DD): ");
 String end = sc.nextLine();
 System.out.print("Enter reason: ");
 String reason = sc.nextLine();
 Date startDate = Date.valueOf(start);
 Date endDate = Date.valueOf(end);
 if (endDate.before(startDate)) {
 System.out.println(
 "End date cannot be before start date!");
 return;
 }
 PreparedStatement check =
 con.prepareStatement(
 "SELECT emp_id FROM employees WHERE emp_id=?");
 check.setInt(1, empId);
 ResultSet rs = check.executeQuery();
 if (!rs.next()) {
 System.out.println("Employee not found!");
 return;
 }
 PreparedStatement ps =
 con.prepareStatement(
 "INSERT INTO leave_requests " +
 "(emp_id, leave_type, start_date, end_date, reason) " +
 "VALUES(?,?,?,?,?)");
 ps.setInt(1, empId);
 ps.setString(2, type);
 ps.setDate(3, startDate);
 ps.setDate(4, endDate);
 ps.setString(5, reason);
 ps.executeUpdate();
 System.out.println("Leave applied successfully!");
 } catch (Exception e) {
 e.printStackTrace();
 }
 }
 // 6. DISPLAY LEAVE REQUESTS
 static void displayLeaveRequests(Connection con) {
 try {
 String sql =
 "SELECT l.leave_id, e.emp_name, l.leave_type, " +
 "l.start_date, l.end_date, l.status " +
 "FROM leave_requests l " +
 "JOIN employees e ON l.emp_id = e.emp_id";
 Statement st = con.createStatement();
 ResultSet rs = st.executeQuery(sql);
 System.out.printf(
 "%-8s %-20s %-15s %-12s %-12s %-12s%n",
 "ID", "EMPLOYEE", "TYPE",
 "START", "END", "STATUS");
 System.out.println(
 "----------------------------------------------------------------------------");
 while (rs.next()) {
 System.out.printf(
 "%-8d %-20s %-15s %-12s %-12s %-12s%n",
 rs.getInt("leave_id"),
 rs.getString("emp_name"),
 rs.getString("leave_type"),
 rs.getDate("start_date"),
 rs.getDate("end_date"),
 rs.getString("status"));
 }
 } catch (SQLException e) {
 e.printStackTrace();
 }
 }
 // 7. APPROVE / REJECT - TRANSACTION
 static void approveRejectLeave(Connection con) {
 try {
 System.out.print("Enter leave ID: ");
 int leaveId = Integer.parseInt(sc.nextLine());
 System.out.print("Enter A for Approve / R for Reject: ");
 String action = sc.nextLine();
 con.setAutoCommit(false);
 PreparedStatement find =
 con.prepareStatement(
 "SELECT emp_id, start_date, end_date, status " +
 "FROM leave_requests WHERE leave_id=?");
 find.setInt(1, leaveId);
 ResultSet rs = find.executeQuery();
 if (!rs.next()) {
 System.out.println("Leave request not found!");
 con.rollback();
 con.setAutoCommit(true);
 return;
 }
 int empId = rs.getInt("emp_id");
 Date startDate = rs.getDate("start_date");
 Date endDate = rs.getDate("end_date");
 String oldStatus = rs.getString("status");
 if (!oldStatus.equals("Pending")) {
 System.out.println("Already processed!");
 con.rollback();
 con.setAutoCommit(true);
 return;
 }
 // Calculate number of leave days
 long difference =
 endDate.getTime() - startDate.getTime();
 int leaveDays =
 (int) (difference /
 (1000 * 60 * 60 * 24)) + 1;
 // APPROVE
 if (action.equalsIgnoreCase("A")) {
 PreparedStatement balance =
 con.prepareStatement(
 "SELECT remaining_leaves " +
 "FROM leave_balance WHERE emp_id=?");
 balance.setInt(1, empId);
 ResultSet br = balance.executeQuery();
 if (!br.next() ||
 br.getInt("remaining_leaves") < leaveDays) {
 System.out.println(
 "Insufficient leave balance!");
 con.rollback();
 con.setAutoCommit(true);
 return;
 }
 // Update leave status
 PreparedStatement updateLeave =
 con.prepareStatement(
 "UPDATE leave_requests " +
 "SET status='Approved' WHERE leave_id=?");
 updateLeave.setInt(1, leaveId);
 updateLeave.executeUpdate();
 // Update balance
 PreparedStatement updateBalance =
 con.prepareStatement(
 "UPDATE leave_balance " +
 "SET used_leaves = used_leaves + ?, " +
 "remaining_leaves = remaining_leaves - ? " +
 "WHERE emp_id=?");
 updateBalance.setInt(1, leaveDays);
 updateBalance.setInt(2, leaveDays);
 updateBalance.setInt(3, empId);
 updateBalance.executeUpdate();
 con.commit();
 System.out.println("Leave approved!");
 System.out.println(
 "Leave days: " + leaveDays);
 System.out.println(
 "Transaction committed!");
 }
 // REJECT
 else if (action.equalsIgnoreCase("R")) {
 PreparedStatement ps =
 con.prepareStatement(
 "UPDATE leave_requests " +
 "SET status='Rejected' " +
 "WHERE leave_id=?");
 ps.setInt(1, leaveId);
 ps.executeUpdate();
 con.commit();
 System.out.println("Leave rejected!");
 System.out.println(
 "Transaction committed!");
 }
 // INVALID ACTION
 else {
 System.out.println("Invalid action!");
 con.rollback();
 }
 con.setAutoCommit(true);
 } catch (Exception e) {
 try {
 con.rollback();
 con.setAutoCommit(true);
 } catch (SQLException ex) {
 ex.printStackTrace();
 }
 System.out.println(
 "Transaction failed. Rollback completed!");
 }
 }
 // 8. LEAVE BALANCE
 static void displayBalance(Connection con) {
 try {
 String sql =
 "SELECT e.emp_id, e.emp_name, " +
 "b.total_leaves, b.used_leaves, " +
 "b.remaining_leaves " +
 "FROM employees e " +
 "JOIN leave_balance b " +
 "ON e.emp_id = b.emp_id";
 Statement st = con.createStatement();
 ResultSet rs = st.executeQuery(sql);
 System.out.printf(
 "%-8s %-20s %-12s %-12s %-12s%n",
 "ID", "NAME", "TOTAL",
 "USED", "REMAINING");
 System.out.println(
 "----------------------------------------------------------------");
 while (rs.next()) {
 System.out.printf(
 "%-8d %-20s %-12d %-12d %-12d%n",
 rs.getInt("emp_id"),
 rs.getString("emp_name"),
 rs.getInt("total_leaves"),
 rs.getInt("used_leaves"),
 rs.getInt("remaining_leaves"));
 }
 } catch (SQLException e) {
 e.printStackTrace();

}

}
